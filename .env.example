# Bu dosyayı .env olarak kopyalayın. Kurulum sihirbazı (/setup) DATABASE_URL ve
# SETUP_COMPLETE değerlerini yerel hedefe göre yeniden yazar.
# Örnek adresler loopback'tir. Üretim sunucusu, kurum dizini veya gerçek parola yazmayın.

# Yer tutucu. "placeholder" sözcüğü kurulum öncesi gerçek bağlantıyı engeller.
DATABASE_URL="sqlserver://127.0.0.1:1433;database=notbak;user=notbak;password=placeholder;encrypt=true"
# PostgreSQL denemesi bu yayında desteklenen kurulum yolu değildir:
# DATABASE_URL="postgresql://notbak:placeholder@127.0.0.1:5432/notbak"

SETUP_COMPLETE=false

# Giriş, bu değer değişmeden kapalı kalır. Üretin: openssl rand -base64 32
SESSION_SECRET="change-me-in-production"

# E-posta bağlantılarında kullanılan adres. Yerel geliştirmede loopback kullanın.
APP_URL="http://127.0.0.1:3000"
# NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# SMTP. Boş bırakılırsa gönderim kapalıdır. Ayrıntı uygulama ayarlarından da verilebilir.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_REJECT_UNAUTHORIZED="true"
MAIL_FROM_EMAIL="noreply@example.com"
MAIL_FROM_NAME="NotBak"

# Dış cron çağrısı için. Boşsa /api/cron uçları reddeder. Üretin: openssl rand -hex 32
CRON_SECRET=""

# Dahili zamanlayıcılar varsayılan açıktır. Kapatmak için false yapın.
# ENABLE_INTERNAL_CRON=false
# ENABLE_INTERNAL_IMAP_POLL=false

# LDAP / Active Directory. Kurulumdan sonra Ayarlar ekranından da verilir.
# Değerler örnektir; kurumunuza ait dizin adresini buraya yazmayın, kendi ortamınızda doldurun.
LDAP_URL="ldap://127.0.0.1:389"
LDAP_BIND_DN="CN=service,OU=Users,DC=example,DC=local"
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="DC=example,DC=local"
LDAP_SEARCH_FILTER="(sAMAccountName=%s)"
LDAP_GROUP_FILTER=""

# Uzak veritabanında şema sıfırlamayı bilinçli açmak için. Varsayılan kapalıdır.
# NOTBAK_ALLOW_REMOTE_DB_RESET=true
